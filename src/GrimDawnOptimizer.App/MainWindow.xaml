<ui:FluentWindow x:Class="GrimDawnOptimizer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:GrimDawnOptimizer.App.ViewModels"
    xmlns:views="clr-namespace:GrimDawnOptimizer.App.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Grim Dawn · 配装助手" Width="1380" Height="900" MinWidth="1100" MinHeight="720"
    Icon="Assets/GrimDawnOptimizer.ico" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
    Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource BodyFont}"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="SourcesTemplate"><views:SourcesView /></DataTemplate>
        <DataTemplate x:Key="BuildTemplate"><views:BuildView /></DataTemplate>
        <DataTemplate x:Key="ResultsTemplate"><views:ResultsView /></DataTemplate>
        <Style x:Key="WindowControl" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="26" /><Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="True" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Dot" Width="13" Height="13" Fill="{TemplateBinding Background}" />
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe UI" FontSize="10"
                                   Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AppTextBrush}" /><Setter TargetName="Dot" Property="StrokeThickness" Value="2" /><Setter TargetName="Glyph" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <Border Grid.RowSpan="3" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" />
        <ui:TitleBar Grid.ColumnSpan="2" Title="" ShowClose="False" ShowMinimize="False" ShowMaximize="False" Background="Transparent" Height="58">
          <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowControl}" Background="{DynamicResource WindowCloseBrush}" Content="×" Click="CloseWindow_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口" />
            <Button Style="{StaticResource WindowControl}" Background="{DynamicResource WindowMinimizeBrush}" Content="−" Click="MinimizeWindow_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口" />
            <Button Style="{StaticResource WindowControl}" Background="{DynamicResource WindowMaximizeBrush}" Content="+" Click="MaximizeWindow_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原窗口" />
        </StackPanel>
          </ui:TitleBar.Header>
        </ui:TitleBar>
        <TextBlock Grid.Column="1" Text="GRIM DAWN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppSecondaryBrush}" Margin="32,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Grid.Column="1" Text="本地配装分析" FontSize="12" Foreground="{DynamicResource AppSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0" IsHitTestVisible="False" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="25,10,20,30">
                <TextBlock Text="配装助手" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="从角色出发，找到更好配装" FontSize="11" Style="{StaticResource SecondaryText}" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="工作空间" Style="{StaticResource FieldLabel}" Margin="25,0,0,10" />
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsSourcesWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceSection.Sources}">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,11,0" /><TextBlock Text="角色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsBuildWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceSection.Build}" IsEnabled="{Binding CanOpenBuild}">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Target20" FontSize="18" Margin="0,0,11,0" /><TextBlock Text="配装分析" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="{Binding IsResultsWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceSection.Results}" IsEnabled="{Binding CanOpenResults}">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Trophy20" FontSize="18" Margin="0,0,11,0" /><TextBlock Text="方案对比" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="20,20,20,18">
                <Border Style="{StaticResource Divider}" Margin="0,0,0,18" />
                <TextBlock Text="外观" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding SelectedThemePreference}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="应用外观" />
                <TextBlock Text="只读存档 · 无需联网" Style="{StaticResource SecondaryText}" FontSize="11" Margin="3,16,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" Margin="32,10,24,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,8,25">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding WorkspaceDescription}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" /></StackPanel>
                <Button Grid.Column="1" Content="刷新角色" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCharacterCommand}" VerticalAlignment="Center" Margin="18,0,0,0" Visibility="{Binding CanOpenBuild, Converter={StaticResource BoolVisibility}}" />
            </Grid>
            <ContentControl x:Name="WorkspaceHost" Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.RenderTransform><TranslateTransform x:Name="WorkspaceTransform" /></ContentControl.RenderTransform>
                <ContentControl.Style><Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource SourcesTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Build}"><Setter Property="ContentTemplate" Value="{StaticResource BuildTemplate}" /></DataTrigger>
                        <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Search}"><Setter Property="ContentTemplate" Value="{StaticResource BuildTemplate}" /></DataTrigger>
                        <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Results}"><Setter Property="ContentTemplate" Value="{StaticResource ResultsTemplate}" /></DataTrigger>
                    </Style.Triggers>
                </Style></ContentControl.Style>
            </ContentControl>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding AppVersion}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="25,0" VerticalAlignment="Center" AutomationProperties.Name="应用版本" />
        <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid Margin="24,0,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressBar Grid.ColumnSpan="2" Value="{Binding ProgressValue, Mode=OneWay}" Height="2" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource AppSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1" Text="{Binding SearchStats}" FontSize="11" Foreground="{DynamicResource AppSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
