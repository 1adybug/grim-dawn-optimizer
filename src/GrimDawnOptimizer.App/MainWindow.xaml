<Window x:Class="GrimDawnOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cairn Loadout Lab" Width="1540" Height="920" MinWidth="1240" MinHeight="760"
        Icon="Assets/CairnLoadoutLab.ico"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CAIRN / LOADOUT LAB" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="只读装备构筑求解器" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="24,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="重新发现" Command="{Binding DiscoverCommand}" Margin="0,0,8,0" />
                    <Button Content="演示数据" Command="{Binding DemoCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="230" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="560" MinWidth="460" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- Sources and characters -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" Padding="18,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="数据来源" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="游戏目录" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="RootPath" />
                        <Button Content="选择游戏目录" Click="BrowseGame_Click" Margin="0,7,0,13" HorizontalAlignment="Stretch" />
                        <TextBlock Text="存档目录" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding SaveLocations}" SelectedItem="{Binding SelectedSaveLocation}" DisplayMemberPath="RootPath" />
                        <Button Content="选择存档目录" Click="BrowseSave_Click" Margin="0,7,0,10" HorizontalAlignment="Stretch" />
                        <Button Content="读取角色与仓库" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" />

                    <StackPanel Grid.Row="3" Margin="0,20,0,9">
                        <TextBlock Text="角色" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CharacterSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox Grid.Row="4" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SaveFilePath}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat=Lv. {0}}" Foreground="{StaticResource Accent}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Divider}" />

            <!-- Rules and scenario -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,28">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="属性优先级" Style="{StaticResource SectionTitle}" />
                        <Button Content="＋ 添加" Command="{Binding AddMetricCommand}" HorizontalAlignment="Right" Padding="10,4" />
                    </Grid>
                    <TextBlock Text="先满足硬下限；优先级数字越小越重要，同层按权重比较。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,-7,0,10" />
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="54" />
                            <ColumnDefinition Width="54" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="属性键" Style="{StaticResource Label}" /><TextBlock Grid.Column="1" Text="显示名" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="层" Style="{StaticResource Label}" /><TextBlock Grid.Column="3" Text="权重" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="4" Text="最小值" Style="{StaticResource Label}" /><TextBlock Grid.Column="5" Text="步长" Style="{StaticResource Label}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="54" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                    <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                    <TextBox Grid.Column="2" Text="{Binding PriorityTier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                    <TextBox Grid.Column="3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                    <TextBox Grid.Column="4" Text="{Binding HardMinimum, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,0,5,0" />
                                    <TextBox Grid.Column="5" Text="{Binding NormalizationStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                                    <Button Grid.Column="6" Content="×" Padding="2" Command="{Binding DataContext.RemoveMetricCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Margin="0,16,0,18" />
                    <TextBlock Text="战斗档案" Style="{StaticResource SectionTitle}" />
                    <Border Background="#182024" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="同级 BOSS 自动基准" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EnemyProfileSummary}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding EnemyResistanceSummary}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="敌人等级" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Profile.Scenario.EnemyLevel, StringFormat=Lv.{0}}" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="战斗时长（秒）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Profile.Scenario.DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="敌人护甲" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Profile.Scenario.EnemyArmor, StringFormat={}{0:N0}}" FontSize="14" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="目标数量" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Profile.Scenario.TargetCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="主攻技能" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding ActiveSkills}" SelectedItem="{Binding SelectedSkill}" DisplayMemberPath="Name" />
                    <TextBlock Text="{Binding BuildFoundationSummary}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Margin="0,18,0,18" />
                    <TextBlock Text="搜索预算" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="时间（秒）" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Profile.SearchBudgetSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="候选数" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Profile.ResultCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="抽样次数" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Profile.MonteCarloTrials, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="运行近似优化" Command="{Binding OptimizeCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <Button Content="保存当前方案" Command="{Binding SaveProfileCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="3" Background="{StaticResource Divider}" />

            <!-- Results and inspector -->
            <Grid Grid.Column="4" Margin="22,20,22,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="最佳候选" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SearchStats}" Foreground="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="不声明全局最优" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="0">
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" /></Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="{Binding Dps, StringFormat={}{0} DPS}" Foreground="{StaticResource Accent}" FontSize="17" Margin="0,3,0,1" />
                                    <TextBlock Grid.Row="2" Text="{Binding Feasibility}" Foreground="{StaticResource Muted}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Background="{StaticResource Divider}" Margin="10,0" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding SelectedResult}" Margin="18,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="持续 DPS" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Dps}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="{Binding MonteCarloRange}" Foreground="{StaticResource Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding TimeToKill, StringFormat=击杀约 {0}}" Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="有效生命" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding EffectiveHealth}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="含抗性/护甲/格挡" Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="预计存活" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding TimeToDeath}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="{Binding Confidence}" Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TierScores}" Foreground="{StaticResource Accent}" Margin="0,14,0,13" />

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="槽位" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="推荐装备 / 附件" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource Label}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SlotRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Slot}" Foreground="{StaticResource Muted}" />
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding CandidateItem}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Attachments}" Foreground="{StaticResource Accent}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CurrentItem, StringFormat=当前：{0}}" Foreground="#707577" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#18342B20" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="约束与置信度提示" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                            <ItemsControl ItemsSource="{Binding ConstraintRows}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#E7A16A" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding WarningRows}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Top" />
                <Grid Margin="18,0">
                    <TextBlock Text="本地计算 · 零遥测 · 存档只读" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SearchStats}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
