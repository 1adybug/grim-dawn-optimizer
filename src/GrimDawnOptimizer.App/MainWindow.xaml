<ui:FluentWindow x:Class="GrimDawnOptimizer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:GrimDawnOptimizer.App.ViewModels"
                 xmlns:views="clr-namespace:GrimDawnOptimizer.App.Views"
                 mc:Ignorable="d"
                 Title="Grim Dawn Optimizer"
                 Width="1440"
                 Height="900"
                 MinWidth="1100"
                 MinHeight="700"
                 Icon="Assets/GrimDawnOptimizer.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True">
    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="SourcesTemplate"><views:SourcesView /></DataTemplate>
        <DataTemplate x:Key="BuildTemplate"><views:BuildView /></DataTemplate>
        <DataTemplate x:Key="SearchTemplate"><views:SearchView /></DataTemplate>
        <DataTemplate x:Key="ResultsTemplate"><views:ResultsView /></DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Grim Dawn Optimizer"
                     Icon="Assets/GrimDawnOptimizer.ico" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,22,16,18">
                        <TextBlock Text="工作区" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                        <TextBlock Text="装备构筑求解器" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <ui:Button Content="数据源"
                                   Icon="{ui:SymbolIcon Database20}"
                                   Style="{StaticResource NavButton}"
                                   Tag="{Binding IsSourcesWorkspace}"
                                   Command="{Binding NavigateCommand}"
                                   CommandParameter="{x:Static vm:WorkspaceSection.Sources}" />
                        <ui:Button Content="构筑参数"
                                   Icon="{ui:SymbolIcon Target20}"
                                   Style="{StaticResource NavButton}"
                                   Tag="{Binding IsBuildWorkspace}"
                                   IsEnabled="{Binding CanOpenBuild}"
                                   Command="{Binding NavigateCommand}"
                                   CommandParameter="{x:Static vm:WorkspaceSection.Build}" />
                        <ui:Button Content="运行优化"
                                   Icon="{ui:SymbolIcon Play20}"
                                   Style="{StaticResource NavButton}"
                                   Tag="{Binding IsSearchWorkspace}"
                                   IsEnabled="{Binding CanOpenSearch}"
                                   Command="{Binding NavigateCommand}"
                                   CommandParameter="{x:Static vm:WorkspaceSection.Search}" />
                        <ui:Button Content="最佳候选"
                                   Icon="{ui:SymbolIcon Trophy20}"
                                   Style="{StaticResource NavButton}"
                                   Tag="{Binding IsResultsWorkspace}"
                                   IsEnabled="{Binding CanOpenResults}"
                                   Command="{Binding NavigateCommand}"
                                   CommandParameter="{x:Static vm:WorkspaceSection.Results}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,12,16,18">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />
                        <TextBlock Text="外观" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedValue="{Binding SelectedThemePreference}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.Name="应用主题" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" Margin="32,24,32,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding WorkspaceTitle}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding WorkspaceDescription}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <ui:InfoBar Grid.Row="1"
                            Margin="0,0,0,18"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Message="{Binding Status}" />

                <ContentControl x:Name="WorkspaceHost"
                                Grid.Row="2"
                                Content="{Binding}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="WorkspaceTransform" />
                    </ContentControl.RenderTransform>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource SourcesTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Build}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource BuildTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Search}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SearchTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentWorkspace}" Value="{x:Static vm:WorkspaceSection.Results}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ResultsTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                             Height="2"
                             VerticalAlignment="Top" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="离线 · 只读"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text=" · 本地计算 · 零遥测 · "
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               AutomationProperties.Name="应用版本" />
                </StackPanel>
                <TextBlock Text="{Binding SearchStats}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
