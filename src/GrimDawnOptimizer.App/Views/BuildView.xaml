<UserControl x:Class="GrimDawnOptimizer.App.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource AppTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource PageScrollViewer}">
            <StackPanel>
                <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前配装" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding CurrentBuildSummary}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="主攻面板 DPS" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CurrentPanelDpsDisplay}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentBrush}" AutomationProperties.Name="当前主攻面板 DPS" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" Margin="0,3" />
                            <StackPanel Grid.Column="2" Margin="20,0">
                                <TextBlock Text="默认攻击 DPS" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CurrentDefaultDpsDisplay}" FontSize="28" FontWeight="SemiBold"
                                           AutomationProperties.Name="当前默认攻击 DPS" />
                            </StackPanel>
                            <Border Grid.Column="3" Background="{DynamicResource AppBorderBrush}" Margin="0,3" />
                            <StackPanel Grid.Column="4" Margin="20,0,0,0">
                                <TextBlock Text="生命" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CurrentHealthDisplay}" FontSize="28" FontWeight="SemiBold"
                                           AutomationProperties.Name="当前生命" />
                            </StackPanel>
                        </Grid>
                        <Expander IsExpanded="False" Margin="0,18,0,0" AutomationProperties.Name="当前配装计算说明">
                            <Expander.Header>
                                <WrapPanel>
                                    <TextBlock Text="计算说明" />
                                    <TextBlock Text="有待确认项" FontSize="12" Margin="12,1,0,0"
                                               Foreground="{DynamicResource AppSecondaryBrush}"
                                               Visibility="{Binding HasCurrentPanelWarning, Converter={StaticResource BoolVisibility}}" />
                                </WrapPanel>
                            </Expander.Header>
                            <TextBlock Text="{Binding CurrentPanelCoverage}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="分析偏好" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
                        <Grid IsEnabled="{Binding IsIdle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="主攻技能" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ActiveSkills}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                                          DisplayMemberPath="Name" MinHeight="34" AutomationProperties.Name="主攻技能" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="难度" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedIndex="{Binding SelectedDifficulty, Mode=TwoWay}"
                                          MinHeight="34" AutomationProperties.Name="目标难度" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="分析目标" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding GoalOptions}" SelectedIndex="{Binding SelectedGoalIndex, Mode=TwoWay}"
                                          MinHeight="34" AutomationProperties.Name="分析目标" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding RequiredStatus}" Style="{StaticResource SecondaryText}" Margin="0,14,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,4">
                    <StackPanel>
                        <Expander Header="临时增益" IsExpanded="False"
                                  Visibility="{Binding HasItemBuffStates, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="默认关闭。仅在对照增益生效时的面板时勾选；重新读取角色会清空。"
                                           Style="{StaticResource SecondaryText}" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding ItemBuffStates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                          HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                </CheckBox>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}"
                                                           FontSize="12" Margin="24,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,14"
                                Visibility="{Binding HasItemBuffStates, Converter={StaticResource BoolVisibility}}" />
                        <Expander Header="特殊战斗场景" IsExpanded="False">
                            <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="默认使用同级 BOSS 基准。以下参数只影响实战分析。"
                                           Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="战斗时长（秒）" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox Value="{Binding ScenarioDurationSeconds, Mode=TwoWay}" Minimum="1" Maximum="300"
                                                      SmallChange="5" MaxDecimalPlaces="1" SpinButtonPlacementMode="Compact"
                                                      AutomationProperties.Name="战斗时长（秒）" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="目标数量" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox Value="{Binding ScenarioTargetCount, Mode=TwoWay}" Minimum="1" Maximum="20"
                                                      SmallChange="1" MaxDecimalPlaces="0" SpinButtonPlacementMode="Compact"
                                                      AutomationProperties.Name="目标数量" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="敌人额外增伤（%）" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox Value="{Binding EnemyDamageIncreasePercent, Mode=TwoWay}" Minimum="0" Maximum="1000"
                                                      MaxDecimalPlaces="1" SpinButtonPlacementMode="Compact"
                                                      AutomationProperties.Name="敌人额外伤害加成百分比" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="难度修正已自动计入；额外效果按整场持续生效计算。"
                                           Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,10,0,18" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="玩家抗性" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="难度惩罚" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="2" Text="额外降抗（百分点）" Style="{StaticResource FieldLabel}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ResistanceDebuffs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Penalty}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppSecondaryBrush}" />
                                                <ui:NumberBox Grid.Column="2" Value="{Binding Reduction, Mode=TwoWay}" Minimum="0" Maximum="100"
                                                              MaxDecimalPlaces="1" SpinButtonPlacementMode="Compact"
                                                              AutomationProperties.Name="{Binding Label, StringFormat={}{0}额外降抗（百分点）}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="查看自动战斗基准" IsExpanded="False" Margin="0,18,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Profile.Scenario.DifficultySummary}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding EnemyProfileSummary}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding EnemyResistanceSummary}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding ScoreBenchmarkSummary}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource PanelSurface}" Margin="0,16,0,0">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,20,0">
                        <Button Content="开始分析" Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}" MinWidth="120" />
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" MinWidth="76" Margin="8,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="自动计算 · 约3分钟 · 最多10套" Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MinHeight="20" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <Grid MinHeight="18" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SearchStats}" Style="{StaticResource SecondaryText}" FontSize="12"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </Grid>
                <Grid Height="4" Margin="0,10,0,0">
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                 Foreground="{DynamicResource AppAccentBrush}" AutomationProperties.Name="配装分析进度" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
