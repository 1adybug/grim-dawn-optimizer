<UserControl x:Class="GrimDawnOptimizer.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="4,0,0,14">
                <TextBlock Text="候选排名" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding SearchStats}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <ListBox x:Name="CandidatesList"
                     Grid.Row="1"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     SelectionChanged="CandidatesList_SelectionChanged"
                     HorizontalContentAlignment="Stretch"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Confidence}"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Dps, StringFormat=减伤后 DPS  {0}}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,2"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding Validity}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Column="2" Margin="24,0,0,0" Style="{StaticResource PageScrollViewer}">
            <Grid x:Name="DetailPanel" DataContext="{Binding SelectedResult}" Margin="0,0,0,24">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DetailTransform" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="计入防御 DPS" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Dps}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="{Binding MonteCarloRange}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="有效生命" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding EffectiveHealth}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="含抗性、护甲与格挡" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="击杀时间" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimeToKill}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="同级 BOSS" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="预计存活" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding TimeToDeath}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="{Binding Confidence}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ScoreSummary}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding UnmitigatedDps, StringFormat=含附件未减伤 {0}}"
                               ToolTip="{Binding UnmitigatedDpsFull, StringFormat=面板 DPS：{0}}"
                               AutomationProperties.HelpText="{Binding UnmitigatedDpsFull, StringFormat=面板 DPS：{0}}"
                               Margin="24,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding EquipmentOnlyUnmitigatedDps, StringFormat=仅装备本体 {0}}"
                               ToolTip="{Binding EquipmentOnlyUnmitigatedDpsFull, StringFormat=仅装备本体面板 DPS：{0}}"
                               AutomationProperties.HelpText="{Binding EquipmentOnlyUnmitigatedDpsFull, StringFormat=仅装备本体面板 DPS：{0}}"
                               Margin="24,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding CombatResistances}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" />
                <TextBlock
                           Text="{Binding ScoreBreakdown}"
                           Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           Margin="0,6,0,18" />
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="装备替换" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="高亮行表示相对当前穿戴发生变化"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SlotRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              MinHeight="300">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="MinHeight" Value="40" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="槽位" Binding="{Binding Slot}" Width="64" />
                            <DataGridTextColumn Header="当前装备" Binding="{Binding CurrentItem}" Width="0.8*" />
                            <DataGridTextColumn Header="推荐装备" Binding="{Binding CandidateItem}" Width="1.0*" />
                            <DataGridTemplateColumn Header="组件及获取方式" Width="1.45*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Component}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="6,5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="增幅及获取方式" Width="1.45*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Augment}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="6,5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="装备位置" Binding="{Binding Source}" Width="1.0*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,20,0,0">
                    <ui:InfoBar IsOpen="{Binding HasWarnings}"
                                IsClosable="False"
                                Severity="Warning"
                                Title="兼容性与置信度提示"
                                Message="{Binding WarningSummary}" />
                    <Expander Header="如何读取来源坐标" Margin="0,12,0,0">
                        <TextBlock Text="页码和坐标均从 1 开始；(X,Y) 是物品左上角所在格，X 向右、Y 向下。组件和增幅分别给出首选及不同类别的备选获取方式；推荐 DPS 要求对应行全部装齐。"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,8,12,4" />
                    </Expander>
                    <Expander Header="单件换装对照 · 其他装备保持当前穿戴" Margin="0,12,0,0"
                              IsExpanded="True" Visibility="{Binding HasSingleSwaps, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="整套排名不保证每件装备单换都提升。这里使用物品现有组件和增幅；比较无临时 Buff、无临时降抗时的游戏面板，不是减伤后战斗 DPS。"
                                       Style="{StaticResource SecondaryText}" Margin="0,0,0,10" />
                            <ComboBox ItemsSource="{Binding SingleSwaps}" SelectedItem="{Binding SelectedSwap}"
                                      DisplayMemberPath="Title" HorizontalAlignment="Stretch" />
                            <StackPanel DataContext="{Binding SelectedSwap}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="520">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性" Binding="{Binding Label}" Width="1.4*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="当前基准" Binding="{Binding Before}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="单换预测" Binding="{Binding Predicted}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="增减" Binding="{Binding Change}" Width="*" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="游戏实测（选填）" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ActualInput, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding Label}" Margin="2" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="实测 − 预测" Binding="{Binding Deviation}" Width="1.5*" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <TextBlock Text="抗性行显示封顶后的面板数值。未填写校准的基准值来自模型。实测值仅用于本次对照，不会自动修改评分或校准系数。"
                                       Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
