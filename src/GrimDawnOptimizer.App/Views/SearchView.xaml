<UserControl x:Class="GrimDawnOptimizer.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PanelStatInputTemplate">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" ToolTip="{Binding Hint}" />
                <ui:TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="可选，留空自动计算" ClearButtonEnabled="True"
                            ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding IsInvalid, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" MinWidth="390" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,28,20">
                <TextBlock Text="计算与校准" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding DpsCalibrationInstructions}"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,5,0,20" />

                <StackPanel IsEnabled="{Binding IsIdle}">
                <CheckBox Content="使用 DPS 校准（可选）"
                          IsChecked="{Binding UsePanelDpsCalibration, Mode=TwoWay}"
                          AutomationProperties.Name="使用 DPS 校准（可选）"
                          Margin="0,0,0,16" />
                <StackPanel Visibility="{Binding UsePanelDpsCalibration, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding CurrentPanelDpsLabel}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding CurrentPanelDpsInput, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="例如 42,000"
                            ClearButtonEnabled="True"
                            AutomationProperties.Name="当前主攻技能 DPS" />
                <TextBlock Text="{Binding CurrentPanelDpsValidationMessage}"
                           Visibility="{Binding IsCurrentPanelDpsInvalid, Converter={StaticResource BoolVisibility}}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="12"
                           Margin="0,6,0,0" />

                <StackPanel Visibility="{Binding UsesSeparateWeaponDpsCalibration, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="默认武器攻击 DPS" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
                    <ui:TextBox Text="{Binding CurrentWeaponAttackDpsInput, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="例如 18,500"
                                ClearButtonEnabled="True"
                                AutomationProperties.Name="默认武器攻击 DPS" />
                    <TextBlock Text="{Binding CurrentWeaponAttackDpsValidationMessage}"
                               Visibility="{Binding IsCurrentWeaponAttackDpsInvalid, Converter={StaticResource BoolVisibility}}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               Margin="0,6,0,0" />
                </StackPanel>
                </StackPanel>

                <Expander Header="角色属性校准（可选）" Margin="0,20,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="在所选难度下，保持当前装备、武器组和常驻光环一致，等临时 Buff、药水和降抗效果消失后读取面板。优先填写生命、OA、DA 和攻速；已封顶的速度如不清楚未封顶值，请留空。"
                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding CorePanelStats}" ItemTemplate="{StaticResource PanelStatInputTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="校准保留换装产生的增减及百分比加成；仍依赖装备技能模型，不能修复未建模的特效。"
                                   Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Expander>
                <Expander Header="抗性、超抗与上限（可选）" Margin="0,10,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="含超抗值 = 当前难度面板抗性 + 超出上限的部分。例如面板 80%、超抗 32%，填 112。上限单独填 80；不要再次减去难度惩罚。"
                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ResistancePanelStats}" ItemTemplate="{StaticResource PanelStatInputTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding PanelStatsSummary}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                <TextBlock Text="属性校准仅用于本次角色会话；切换角色或难度会清空。重新配装后请重新载入存档并填写。"
                           Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,5,0,8" />
                <ui:Button Content="清空可选属性" Command="{Binding ClearPanelStatsCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" />

                <TextBlock Text="运行" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="搜索会并行使用最多 16 个工作线程，完成后自动打开最佳候选。"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,5,0,16" />

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="运行多策略优化"
                               Icon="{ui:SymbolIcon Play20}"
                               Appearance="Primary"
                               Command="{Binding OptimizeCommand}"
                               MinWidth="190"
                               Margin="0,0,8,0" />
                    <ui:Button Content="取消"
                               Icon="{ui:SymbolIcon Dismiss16}"
                               Appearance="Secondary"
                               Command="{Binding CancelCommand}" />
                </StackPanel>

                <Grid Margin="0,24,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Width="48"
                                     Height="48"
                                     Progress="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="False" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SearchStats}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Grid.Column="2" Margin="28,0,0,20">
                <TextBlock Text="搜索范围" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="更长时间和更多抽样通常能提高候选覆盖与复核稳定性。"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,5,0,20" />

                <TextBlock Text="时间预算（秒）" Style="{StaticResource FieldLabel}" />
                <ui:NumberBox Value="{Binding Profile.SearchBudgetSeconds, Mode=TwoWay}"
                              Minimum="1"
                              Maximum="300"
                              SmallChange="10"
                              MaxDecimalPlaces="0"
                              SpinButtonPlacementMode="Compact" />

                <TextBlock Text="最终候选数" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ui:NumberBox Value="{Binding Profile.ResultCount, Mode=TwoWay}"
                              Minimum="1"
                              Maximum="50"
                              SmallChange="1"
                              MaxDecimalPlaces="0"
                              SpinButtonPlacementMode="Compact" />

                <TextBlock Text="Monte Carlo 抽样次数" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <ui:NumberBox Value="{Binding Profile.MonteCarloTrials, Mode=TwoWay}"
                              Minimum="500"
                              Maximum="10000"
                              SmallChange="500"
                              LargeChange="1000"
                              MaxDecimalPlaces="0"
                              SpinButtonPlacementMode="Compact" />

                <ui:InfoBar IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="推荐默认值"
                            Message="180 秒、10 个候选、每个候选 4,000 次抽样。"
                            Margin="0,24,0,0" />

                <TextBlock Text="{Binding BuildFoundationSummary}"
                           Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
