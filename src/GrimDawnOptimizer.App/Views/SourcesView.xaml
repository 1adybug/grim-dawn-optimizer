<UserControl x:Class="GrimDawnOptimizer.App.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource AppTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" MinWidth="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Style="{StaticResource PageScrollViewer}">
            <Border Style="{StaticResource PanelSurface}">
                <StackPanel>
                    <TextBlock Text="数据来源" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="自动识别游戏与存档位置。" Style="{StaticResource SecondaryText}" Margin="0,5,0,24" />

                    <TextBlock Text="游戏目录" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedInstallation.RootPath, TargetNullValue=尚未识别游戏目录, FallbackValue=尚未识别游戏目录}"
                               TextWrapping="Wrap" AutomationProperties.Name="已选择的游戏目录" />
                    <TextBlock Text="{Binding SelectedInstallation.Source}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,18" />
                    <TextBlock Text="存档目录" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedSaveLocation.RootPath, TargetNullValue=尚未识别存档目录, FallbackValue=尚未识别存档目录}"
                               TextWrapping="Wrap" AutomationProperties.Name="已选择的存档目录" />
                    <TextBlock Text="{Binding SelectedSaveLocation.Source}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />

                    <Expander Header="修改目录" IsExpanded="False" Margin="0,22,0,0">
                        <StackPanel Margin="0,14,0,0" IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="游戏目录" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择游戏目录" MinHeight="34">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,8,0,18">
                                <Button Content="选择文件夹…" Style="{StaticResource SecondaryButton}" Click="BrowseGame_Click"
                                        AutomationProperties.Name="选择游戏文件夹" Margin="0,0,8,0" />
                                <Button Content="移除记录" Style="{StaticResource QuietButton}"
                                        Command="{Binding DeleteGameDirectoryCommand}" CommandParameter="{Binding SelectedInstallation}"
                                        ToolTip="仅从历史列表移除，不删除磁盘目录" AutomationProperties.Name="移除游戏目录记录" />
                            </WrapPanel>
                            <TextBlock Text="存档目录" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding SaveLocations}" SelectedItem="{Binding SelectedSaveLocation, Mode=TwoWay}"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择存档目录" MinHeight="34">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="选择文件夹…" Style="{StaticResource SecondaryButton}" Click="BrowseSave_Click"
                                        AutomationProperties.Name="选择存档文件夹" Margin="0,0,8,0" />
                                <Button Content="移除记录" Style="{StaticResource QuietButton}"
                                        Command="{Binding DeleteSaveDirectoryCommand}" CommandParameter="{Binding SelectedSaveLocation}"
                                        ToolTip="仅从历史列表移除，不删除磁盘目录" AutomationProperties.Name="移除存档目录记录" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,22,0,18" />
                    <WrapPanel>
                        <Button Content="读取角色" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}"
                                MinWidth="112" Margin="0,0,8,0" />
                        <Button Content="重新识别" Style="{StaticResource SecondaryButton}" Command="{Binding DiscoverCommand}" />
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="读取已保存的角色与仓库，不会改写存档。" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MinHeight="40" Margin="0,14,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <Grid Height="4" Margin="0,8,0,0">
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                     Foreground="{DynamicResource AppAccentBrush}" AutomationProperties.Name="正在读取角色" />
                    </Grid>
                    <Expander Header="没有可用存档？" IsExpanded="False" Margin="0,18,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="可以先用演示角色了解分析流程。" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                            <Button Content="载入演示角色" Style="{StaticResource QuietButton}" Command="{Binding DemoCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Column="2" Style="{StaticResource PanelSurface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="角色" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="选择一个角色开始配装分析。" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding CharacterSummary}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                         Visibility="{Binding HasCharacters, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding IsIdle}"
                         HorizontalContentAlignment="Stretch" BorderThickness="0" Background="{DynamicResource AppSurfaceBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="选择角色">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SaveFilePath}" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource AppSecondaryBrush}" TextWrapping="Wrap"
                                                   AutomationProperties.HelpText="{Binding SaveFilePath}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat=Lv. {0}}"
                                               Foreground="{DynamicResource AppSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Visibility="{Binding HasNoCharacters, Converter={StaticResource BoolVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Margin="16,32">
                    <TextBlock Text="尚未读取角色" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="确认左侧目录后，点击“读取角色”。" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
